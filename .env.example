#
# Meetza Frontend (.env.example)
# Copy this file to ".env" and edit values as needed.
#

# Example values for local development only
# Do NOT commit your real .env file to version control

# Windows (PowerShell):
#   Copy-Item .env.example .env
#

# Backend REST API base URL (must include /api and start with http or https)

# Local Development
REACT_APP_API_URL=http://localhost:4000/api
REACT_APP_SOCKET_URL=http://localhost:4000

# Example only - replace with real values in production

# Production environment variables (override local values when deploying)
REACT_APP_API_URL=https://your-domain.com/api
REACT_APP_SOCKET_URL=https://your-domain.com

# Optional: Google reCAPTCHA site key (leave empty if not used)
# Public site key (safe to expose)
REACT_APP_RECAPTCHA_SITE_KEY=
